{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "workspace": {
    "ignoreDir": [
      ".rocks",
      "build",
      "tmp"
    ]
  },
  "runtime": {
    "version": "LuaJIT"
  },
  "diagnostics": {
    "disable": [
      "duplicate-require",
      "need-check-nil",
      "param-type-mismatch",
      "redefined-local",
      "undefined-field",
      "unnecessary-if",
      "unresolved-require",
      "unused"
    ],
    "globals": [
      "box"
    ]
  }
}
